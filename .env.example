DATABASE_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/chatbot_db
JWT_SECRET_KEY=your-secret-key-here
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Which model answers the questions: deepseek (default), gemini or groq
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
GROQ_API_KEY=your_groq_api_key_here

# Sign-in: password (default) or microsoft
AUTH_MODE=password
ALLOWED_EMAIL_DOMAIN=sharjah.ac.ae
AUTH_DEV_LOGIN=true
MS_TENANT_ID=
MS_CLIENT_ID=